# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,md}]
indent_size = 2

# Trailing whitespace is significant in Markdown (two spaces is a hard line break), so the
# global trim rule is turned off here rather than silently rewriting prose.
[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

# Copies of files generated elsewhere, compared byte for byte. An editor must not touch them.
[{contracts/*.json,parity/EndpointID.swift,third_party/geist/OFL.txt,core/core-designsystem/src/main/res/raw/license_geist.txt}]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset

# Every text file is stored and checked out with LF, on every platform. The contract fixtures
# and the parity snapshot are compared with what another repository generated, so a checkout
# must not rewrite their line endings.
* text=auto eol=lf

# The Windows start script is the one exception.
*.bat text eol=crlf

# Binary files are never converted or diffed as text.
*.jar binary
*.png binary
*.webp binary
*.ttf binary

# Collapsed in pull request diffs and left out of the language statistics: the fixtures are
# generated by the server's test suite and the Swift file is a copy of another repository's.
contracts/*.json linguist-generated=true
parity/EndpointID.swift linguist-vendored=true

# Third-party files copied unchanged from their projects; NOTICE says what each one is.
third_party/** linguist-vendored=true
